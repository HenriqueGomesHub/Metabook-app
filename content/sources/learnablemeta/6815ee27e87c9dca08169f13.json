    },
    {
      "id": 359443,
      "name": "Greenhouses",
      "note": "<p><strong>Large clusters</strong> of <strong>plastic greenhouses</strong> are common and effective in the <strong>Ierapetra area</strong> of southeastern <strong>Crete</strong>. Smaller greenhouse clusters also appear along other parts of Crete's southern coast.</p>",
      "images": [

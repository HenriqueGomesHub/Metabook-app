    },
    {
      "id": 296192,
      "name": "Aleppo Pine",
      "note": "<p><strong>Aleppo pine</strong> grows across <strong>Central Greece</strong> and is typical in Attica and <strong>northern Euboea</strong>. It's also common in the Chalkidiki \"<strong>fingers</strong>.\" Unlike Brutia pine, Aleppo often forms dense forests.</p>",
      "images": [
        "https://learnablemeta.com/images/1278/Moxj61c5iiotOHqbguxbuod7d36WnPNgLV6N.avif"
      ],
      "locationsCount": 5,

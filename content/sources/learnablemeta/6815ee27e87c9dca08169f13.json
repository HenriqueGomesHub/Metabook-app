    {
      "id": 296181,
      "name": "Agricultural Valleys",
      "note": "<p>The largest <strong>flat agricultural valleys</strong> in Greece are near <strong>Thessaloniki</strong> and <strong>Larissa</strong>. Smaller flat valleys, with mountains appearing closer, are found in other parts of the north and center.</p>",
      "images": [
        "https://learnablemeta.com/images/1278/lnhzwLWDk9YdUSAWWVGeH4d1FrCk7UsLj9q6.avif"
      ],
      "locationsCount": 10,

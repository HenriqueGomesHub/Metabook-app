    {
      "id": "cx-bapH",
      "step": 0,
      "order": 1,
      "family": "other",
      "title": "Location: small island south of Java",
      "text": [
        "Christmas Island is a small **island territory** south-southwest of Java. It is an Australian external territory, so for country streaks purposes it is counted as part of Australia.",
        "NOTE: Do not get its location confused with the Cocos (Keeling) Islands, which are another Australian territory a little west of Christmas Island."
      ],
      "tags": [],
      "images": [],
      "locations": [],
      "lookalikes": [
        "AU",
        "CC"
      ],
      "credit": {
        "source": "Plonk It",
        "url": "https://www.plonkit.net/christmas-island",
        "licence": "CC BY-NC-SA 4.0"
      },
      "summary": "A small island south-southwest of Java. It belongs to Australia, so it counts as Australia in streaks. Don't confuse it with the Cocos Islands, a bit further west.",
      "differs": [
        {
          "country": "CC",
          "how": "Cocos (Keeling) Islands lie a little west of Christmas Island"
        }
      ]
    },
    {

          "width": 600,
          "height": 392
        }
      ],
      "locations": [],
      "lookalikes": [
        "FR"
      ],
      "credit": {
        "source": "Plonk It",
        "url": "https://www.plonkit.net/saint-pierre-and-miquelon",
        "licence": "CC BY-NC-SA 4.0"
      },
      "summary": "Plates can be white or yellow, short or long, always with a blue EU strip. White ones also have a blue strip on the right, like France. Front plates are sometimes missing.",
      "sameAs": [
        "FR"
      ]
    },

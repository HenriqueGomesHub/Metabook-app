  "clues": [
    {
      "id": "pm-o6jY",
      "step": 0,
      "order": 1,
      "family": "other",
      "title": "Coverage: French territory off Canada",
      "text": [
        "Saint Pierre and Miquelon, officially the Territorial Collectivity of Saint-Pierre and Miquelon, is an overseas department and region of France, south of Newfoundland in Canada. As such, for country streaks purposes, it is **counted as France**."
      ],
      "tags": [],
      "images": [],
      "locations": [],
      "lookalikes": [
        "CA",
        "FR"
      ],
      "credit": {
        "source": "Plonk It",
        "url": "https://www.plonkit.net/saint-pierre-and-miquelon",
        "licence": "CC BY-NC-SA 4.0"
      },
      "summary": "A small French island group south of Newfoundland. For country streaks it counts as France, so guess France if you spot it."
    },
    {
      "id": "pm-XNt7",
      "step": 0,
      "order": 2,
      "family": "plate",
      "title": "Plate: white or yellow, blue EU strip",
      "text": [
        "Licence plates can be either white or yellow and either short or long. They all have a blue EU strip however, and the white plates will also have a blue strip on the right, as is custom in France. Vehicles may or may not have front plates."
      ],
      "tags": [],
      "images": [
        {
          "id": "76750a2c2005",
          "src": "https://www.plonkit.net/images/saint-pierre-and-miquelon/pm_licenceplate.png",

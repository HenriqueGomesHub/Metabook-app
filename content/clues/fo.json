    {
      "id": "fo-q721",
      "step": 0,
      "order": 6,
      "family": "language",
      "title": "Language: Ð and Á letters, plus Ø",
      "text": [
        "The Faroese language is most closely related to Icelandic, with the special letters Á, Ð, Í, Ó, Ú, Ý, Æ and Ø. It differs from Icelandic by using the letter **Ø**, while Icelandic uses É and Þ."
      ],
      "tags": [],
      "images": [
        {
          "id": "454f518663c0",
          "src": "https://www.plonkit.net/images/faroe-islands/fo_language.png",
          "path": "fo/454f518663c0.webp",
          "width": 600,
          "height": 338,
          "role": "example",
          "caption": "Faroese text with the letters Ð Á Í Ó Ú Ý Æ Ø shown large"
        }
      ],
      "locations": [],
      "lookalikes": [],
      "credit": {
        "source": "Plonk It",
        "url": "https://www.plonkit.net/faroe-islands",
        "licence": "CC BY-NC-SA 4.0"
      },
      "summary": "Uses Á, Ð, Í, Ó, Ú, Ý, Æ and Ø. Seeing Ø separates it from Icelandic, which uses É and Þ instead.",
      "differs": [
        {
          "country": "IS",
          "how": "Iceland uses É and Þ, not Ø"
        }
      ]
    },

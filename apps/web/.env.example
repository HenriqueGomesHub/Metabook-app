# Leave both empty to run in local mode (IndexedDB, no login, single user).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: base URL of the public `media` bucket for photo cards, ending in /media/.
# Defaults to <VITE_SUPABASE_URL>/storage/v1/object/public/media/; set it for local-mode deploys.
VITE_MEDIA_BASE=
